{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "makiety",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "python3 -m http.server \"${PORT:-8765}\" --bind 127.0.0.1 --directory site"],
      "port": 8765,
      "autoPort": true
    },
    {
      "name": "app",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd app && npx next dev -p \"${PORT:-3000}\""],
      "port": 3000,
      "autoPort": true
    }
  ]
}
